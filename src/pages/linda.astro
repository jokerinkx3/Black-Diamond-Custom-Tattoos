---
import SiteLayout from "../layouts/SiteLayout.astro";
import WixProjectForm from "../components/WixProjectForm";
import { lindaCopy } from "../content/copy";
import { lindaForm } from "../data/forms";

const heroImage = "https://static.wixstatic.com/media/0ef1aa_fb25f82ef09a42a5ac519d5667477827~mv2.jpg";
const colorImage = "https://static.wixstatic.com/media/0ef1aa_8e460fc3dcd049579bb5c1defa6a5c04~mv2.webp";
---
<SiteLayout title="Linda G | Color Realism & Cover-Up Tattoo Artist Las Vegas" bodyClass="artist-page linda-page">
  <section class="artist-hero" style={`--hero-image:url('${heroImage}')`}>
    <div class="artist-hero-content">
      <p class="artist-signature">Linda G</p>
      <h1>{lindaCopy.hero.heading}</h1>
      <p>{lindaCopy.hero.body}</p>
      <div class="hero-actions">
        <a class="button" href="#submit-project">{lindaCopy.hero.primaryCta}</a>
        <a class="text-link" href="#artist-work">{lindaCopy.hero.secondaryCta} ↓</a>
      </div>
    </div>
  </section>

  <section id="artist-work" class="artist-sections">
    {lindaCopy.sections.map((section, index) => (
      <article class={`artist-statement statement-${index + 1}`}>
        <p class="section-number">0{index + 1}</p>
        <div>
          <h2>{section.heading}</h2>
          {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </article>
    ))}
  </section>

  <section class="image-interlude" style={`--interlude-image:url('${colorImage}')`}>
    <blockquote>{lindaCopy.background}</blockquote>
  </section>

  <section class="case-study section-wrap">
    <p class="section-number">05</p>
    <div>
      <h2>{lindaCopy.caseStudy.heading}</h2>
      {lindaCopy.caseStudy.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section class="investment section-wrap">
    <p class="section-number">06</p>
    <div>
      <h2>{lindaCopy.investment.heading}</h2>
      {lindaCopy.investment.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section id="submit-project" class="form-section">
    <div class="form-intro">
      <p class="small-label">Project consideration</p>
      <h2>{lindaCopy.form.heading}</h2>
      <p>{lindaCopy.form.body}</p>
      <p class="minimum-note">Custom projects begin at $1,000.</p>
    </div>
    <WixProjectForm client:load manifest={lindaForm} />
  </section>
</SiteLayout>
