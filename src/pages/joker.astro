---
import SiteLayout from "../layouts/SiteLayout.astro";
import WixProjectForm from "../components/WixProjectForm";
import { jokerCopy } from "../content/copy";
import { jokerForm } from "../data/forms";

const heroImage = "https://static.wixstatic.com/media/0ef1aa_61d59b948d9f40ed95f0abba86e9ecc8~mv2.webp";
---
<SiteLayout title="Joker Ink | Black & Grey Realism Tattoo Artist Las Vegas" bodyClass="artist-page joker-page">
  <section class="artist-hero" style={`--hero-image:url('${heroImage}')`}>
    <div class="artist-hero-content">
      <p class="artist-signature">Joker Ink</p>
      <h1>{jokerCopy.hero.heading}</h1>
      <p>{jokerCopy.hero.body}</p>
      <div class="hero-actions">
        <a class="button" href="#submit-project">{jokerCopy.hero.primaryCta}</a>
        <a class="text-link" href="#artist-work">{jokerCopy.hero.secondaryCta} ↓</a>
      </div>
    </div>
  </section>

  <section id="artist-work" class="artist-sections">
    {jokerCopy.sections.map((section, index) => (
      <article class={`artist-statement statement-${index + 1}`}>
        <p class="section-number">0{index + 1}</p>
        <div>
          <h2>{section.heading}</h2>
          {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </article>
    ))}
  </section>

  <section class="investment section-wrap">
    <p class="section-number">05</p>
    <div>
      <h2>{jokerCopy.investment.heading}</h2>
      {jokerCopy.investment.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section id="submit-project" class="form-section">
    <div class="form-intro">
      <p class="small-label">Project consideration</p>
      <h2>{jokerCopy.form.heading}</h2>
      <p>{jokerCopy.form.body}</p>
      <p class="minimum-note">Custom projects begin at $1,000.</p>
    </div>
    <WixProjectForm client:load manifest={jokerForm} />
  </section>
</SiteLayout>
