---
import SiteLayout from "../layouts/SiteLayout.astro";
import { homeCopy } from "../content/copy";

const jokerImage = "https://static.wixstatic.com/media/0ef1aa_61d59b948d9f40ed95f0abba86e9ecc8~mv2.webp";
const lindaImage = "https://static.wixstatic.com/media/0ef1aa_fb25f82ef09a42a5ac519d5667477827~mv2.jpg";
---
<SiteLayout title="Black Diamond Custom Tattoos | North Las Vegas" bodyClass="home-page">
  <section class="split-hero">
    <h1>{homeCopy.hero}</h1>
    <a class="artist-panel artist-panel-joker" href="/joker" style={`--panel-image: url('${jokerImage}')`}>
      <span class="artist-name">{homeCopy.joker.name}</span>
      <span class="artist-line">{homeCopy.joker.line}</span>
      <span class="text-link">{homeCopy.joker.cta} →</span>
    </a>
    <a class="artist-panel artist-panel-linda" href="/linda" style={`--panel-image: url('${lindaImage}')`}>
      <span class="artist-name">{homeCopy.linda.name}</span>
      <span class="artist-line">{homeCopy.linda.line}</span>
      <span class="text-link">{homeCopy.linda.cta} →</span>
    </a>
  </section>

  <section class="editorial-intro section-wrap">
    <p class="section-number">01</p>
    <div>
      <h2>{homeCopy.introduction.heading}</h2>
      {homeCopy.introduction.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section class="dual-feature">
    <article class="feature feature-dark">
      <div class="feature-image" style={`background-image:url('${jokerImage}')`}></div>
      <div class="feature-copy">
        <p class="small-label">Joker Ink</p>
        <h2>Work with presence.</h2>
        <p>Large-scale black-and-grey realism and Norse work designed to hold its shape from across the room, then reward a closer look.</p>
        <a class="text-link" href="/joker">Enter Joker’s work →</a>
      </div>
    </article>
    <article class="feature feature-color">
      <div class="feature-image" style={`background-image:url('${lindaImage}')`}></div>
      <div class="feature-copy">
        <p class="small-label">Linda G</p>
        <h2>Work that changes the view.</h2>
        <p>Vivid color realism and complex cover-ups that replace an unwanted reminder with art the client wants to see.</p>
        <a class="text-link" href="/linda">Enter Linda’s work →</a>
      </div>
    </article>
  </section>

  <section class="proof-statement section-wrap">
    <p class="section-number">02</p>
    <div>
      {homeCopy.proof.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section class="final-choice">
    <h2>{homeCopy.finalChoice.heading}</h2>
    <p>{homeCopy.finalChoice.line}</p>
    <div class="choice-links">
      <a class="button" href="/joker">Explore Joker</a>
      <a class="button button-secondary" href="/linda">Explore Linda</a>
    </div>
  </section>
</SiteLayout>
